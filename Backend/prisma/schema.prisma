generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nombre   String
  username String @unique
  password String

  createdAt DateTime @default(now())
}

model Campaign {
  id       Int     @id @default(autoincrement())
  nombre   String
  hex      String?
  logo_url String?

  storage_key String @unique

  sedes        CampaignSede[]
  asignaciones AsignacionMedia[]

  ventas Venta[]
}

model Sede {
  id     Int    @id @default(autoincrement())
  nombre String

  campaigns CampaignSede[]
  captions  SedeCaption[]
  ventas    Venta[]
}

model Media {
  id     Int    @id @default(autoincrement())
  nombre String
  url    String

  mimeType   String?
  durationMs Int?     @default(10000)
  createdAt  DateTime @default(now())

  asignaciones AsignacionMedia[]
}

model Caption {
  id    Int     @id @default(autoincrement())
  title String
  text  String  @db.LongText
  hex   String?

  createdAt DateTime @default(now())

  sedes SedeCaption[]

  @@index([createdAt])
}

model Venta {
  id                Int              @id @default(autoincrement())
  sica_id           String
  nombre_empleado   String
  tipo_empleado     TipoEmpleado
  variante_empleado VarianteEmpleado
  sede_id           Int?
  campaign_id       Int?
  fecha             DateTime

  campaign Campaign? @relation(fields: [campaign_id], references: [id])
  sede     Sede?     @relation(fields: [sede_id], references: [id])

  @@unique([sica_id, campaign_id, tipo_empleado], name: "venta_sica_participante")
  @@index([campaign_id])
  @@index([sede_id])
  @@index([fecha])
  @@index([variante_empleado])
  @@index([nombre_empleado])
  @@index([campaign_id, sede_id, nombre_empleado, variante_empleado, fecha])
}

enum VarianteEmpleado {
  OJT
  ALTA
  SUP
}

enum TipoEmpleado {
  CERRADOR
  AGENTE
}

//INTERSECCIONES
model CampaignSede {
  campaign_id Int
  sede_id     Int

  campaign Campaign @relation(fields: [campaign_id], references: [id])
  sede     Sede     @relation(fields: [sede_id], references: [id])

  @@id([campaign_id, sede_id])
  @@index([campaign_id])
  @@index([sede_id])
}

model AsignacionMedia {
  campaign_id Int
  media_id    Int

  started_at DateTime?
  ended_at   DateTime?
  prioridad  Int       @default(0)

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@id([campaign_id, media_id])
  @@index([campaign_id])
  @@index([started_at, ended_at])
  @@index([campaign_id, prioridad])
}

model SedeCaption {
  sede_id    Int
  caption_id Int

  started_at DateTime?
  ended_at   DateTime?

  sede    Sede    @relation(fields: [sede_id], references: [id], onDelete: Cascade)
  caption Caption @relation(fields: [caption_id], references: [id], onDelete: Cascade)

  @@id([sede_id, caption_id])
  @@index([sede_id])
  @@index([started_at, ended_at])
}

//CONFIG

model ConfigRanking {
  id            Int          @id @default(1)
  modo          ModoRanking @default(DEFAULT)

  fecha_inicio  DateTime
  fecha_fin     DateTime

  zona_horaria String @default("America/Lima")
  updateAt  DateTime @updatedAt
}

enum ModoRanking {
  DEFAULT
  PERSONALIZADO
}
